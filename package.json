{
  "name": "treino",
  "version": "1.0.0",
  "description": "Plano de treino pessoal",
  "scripts": {
    "start": "http-server -p 8000 -c-1",
    "smoke": "node scripts/smoke.mjs",
    "build:www": "node scripts/build-www.mjs",
    "android:add": "npm run build:www && npx cap add android",
    "android:sync": "npm run build:www && npx cap sync android",
    "android:open": "npx cap open android",
    "test:journeys": "node scripts/journeys-test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:theme": "node scripts/theme-test.mjs",
    "test:dialogs": "node scripts/dialog-test.mjs",
    "test:hoje": "node scripts/hoje-test.mjs",
    "test:onb-choices": "node scripts/onboarding-choices-test.mjs",
    "test:ux1": "node scripts/ux-bloco1-test.mjs",
    "test:ux": "node scripts/ux-test.mjs",
    "test:timer": "node scripts/timer-test.mjs",
    "test:superset": "node scripts/superset-test.mjs",
    "test:plan": "node scripts/plan-test.mjs",
    "test:onboarding": "node scripts/onboarding-test.mjs",
    "test:sw-update": "node scripts/sw-update-test.mjs",
    "test:hoje-semana": "node scripts/hoje-semana-test.mjs",
    "test:cards": "node scripts/cards-test.mjs",
    "test:a11y": "node scripts/a11y-test.mjs",
    "test:drafts": "node scripts/drafts-test.mjs",
    "test:b6": "node scripts/bloco6-test.mjs",
    "test:data": "node scripts/history-test.mjs && node scripts/muscle-test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "type": "module"
}
