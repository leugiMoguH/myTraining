{
  "name": "treino",
  "version": "1.0.0",
  "description": "Plano de treino pessoal",
  "scripts": {
    "start": "http-server -p 8000 -c-1",
    "smoke": "node scripts/smoke.mjs",
    "build:www": "node scripts/build-www.mjs",
    "android:add": "npm run build:www && npx cap add android",
    "android:sync": "npm run build:www && npx cap sync android",
    "android:open": "npx cap open android",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "type": "module"
}
